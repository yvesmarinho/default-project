#!/usr/bin/env bash
#
# new-project — Wrapper conveniente para Enterprise Default Project Template scaffold
#
# Uso:
#   new-project                          # Modo interativo
#   new-project my-api                   # Quick start (Python programming)
#   new-project my-api --domain infra    # Com domínio específico
#   new-project --help                   # Ajuda completa
#

set -euo pipefail

# Cores
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Caminho do template (ajustar conforme sua instalação)
TEMPLATE_DIR="${HOME}/Documentos/DevOps/Vya-Jobs/a-default-project"
SCAFFOLD_SCRIPT="${TEMPLATE_DIR}/scripts/scaffold.py"

# Validar que o template existe
if [[ ! -f "${SCAFFOLD_SCRIPT}" ]]; then
    echo -e "${RED}❌ Erro: Template não encontrado em ${TEMPLATE_DIR}${NC}"
    echo -e "${YELLOW}💡 Ajuste a variável TEMPLATE_DIR no script: ~/.local/bin/new-project${NC}"
    exit 1
fi

# Função de ajuda
show_help() {
    cat << EOF
${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  🚀 new-project — Enterprise Project Scaffold
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}

${GREEN}Uso:${NC}
  new-project                           ${BLUE}# Modo interativo${NC}
  new-project my-api                    ${BLUE}# Quick start (Python programming)${NC}
  new-project my-api --domain infra     ${BLUE}# Com domínio específico${NC}
  new-project my-api --compose python-fastapi  ${BLUE}# Com perfil Layer 2${NC}

${GREEN}Opções:${NC}
  -h, --help                Show this help
  --list-profiles           List available profiles
  --validate                Validate all profile descriptors
  --domain DOMAIN           Domain: programming|infrastructure|analysis
  --language LANG           Language: python|typescript|go|other
  --compose PROFILE         Use Layer 2 profile (python-fastapi, etc.)
  --target-dir DIR          Parent directory for project (default: parent of current dir)

${GREEN}Exemplos:${NC}

  ${YELLOW}# Modo interativo completo${NC}
  new-project

  ${YELLOW}# Backend Python FastAPI${NC}
  new-project my-api --compose python-fastapi

  ${YELLOW}# Frontend Next.js${NC}
  new-project my-frontend --compose typescript-next

  ${YELLOW}# Infraestrutura Terraform${NC}
  new-project infra-aws --domain infrastructure --compose terraform-aws

  ${YELLOW}# Projeto em diretório específico${NC}
  new-project my-project --target-dir ~/Projects

${GREEN}Perfis disponíveis:${NC}
  Execute: ${CYAN}new-project --list-profiles${NC}

${GREEN}Documentação:${NC}
  Template: ${TEMPLATE_DIR}
  Quick Start: ${TEMPLATE_DIR}/QUICKSTART.md
  Rules: ${TEMPLATE_DIR}/.copilot-rules.md

EOF
}

# Função para listar perfis
list_profiles() {
    echo -e "${CYAN}📋 Perfis disponíveis:${NC}\n"
    cd "${TEMPLATE_DIR}"
    python "${SCAFFOLD_SCRIPT}" --list-profiles
}

# Função para validar perfis
validate_profiles() {
    echo -e "${CYAN}🔍 Validando perfis...${NC}\n"
    cd "${TEMPLATE_DIR}"
    python "${SCAFFOLD_SCRIPT}" --validate
}

# Parse argumentos
if [[ $# -eq 0 ]]; then
    # Modo interativo
    echo -e "${CYAN}🚀 Criando novo projeto (modo interativo)${NC}\n"
    cd "${TEMPLATE_DIR}"
    exec python "${SCAFFOLD_SCRIPT}" new
fi

case "${1}" in
    -h|--help)
        show_help
        exit 0
        ;;
    --list-profiles)
        list_profiles
        exit 0
        ;;
    --validate)
        validate_profiles
        exit 0
        ;;
    --*)
        # Opção sem nome de projeto
        echo -e "${RED}❌ Erro: Nome do projeto obrigatório${NC}"
        echo -e "${YELLOW}Use: new-project NOME [opções]${NC}"
        echo -e "${YELLOW}Ou: new-project --help${NC}"
        exit 1
        ;;
    *)
        # Nome do projeto fornecido
        PROJECT_NAME="${1}"
        shift
        
        # Validar formato do nome
        if [[ ! "${PROJECT_NAME}" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
            echo -e "${RED}❌ Erro: Nome inválido '${PROJECT_NAME}'${NC}"
            echo -e "${YELLOW}Use apenas letras minúsculas, números e hífens (kebab-case)${NC}"
            echo -e "${YELLOW}Exemplo: my-api-v2${NC}"
            exit 1
        fi
        
        # Construir comando
        CMD=(python "${SCAFFOLD_SCRIPT}" new --ci --name "${PROJECT_NAME}")
        
        # Adicionar opções default se não fornecidas
        HAS_DOMAIN=0
        HAS_LANGUAGE=0
        HAS_COMPOSE=0
        
        for arg in "$@"; do
            case "${arg}" in
                --domain) HAS_DOMAIN=1 ;;
                --language) HAS_LANGUAGE=1 ;;
                --compose) HAS_COMPOSE=1 ;;
            esac
        done
        
        # Defaults
        if [[ ${HAS_DOMAIN} -eq 0 && ${HAS_COMPOSE} -eq 0 ]]; then
            CMD+=(--domain programming)
        fi
        
        if [[ ${HAS_LANGUAGE} -eq 0 && ${HAS_COMPOSE} -eq 0 ]]; then
            CMD+=(--language python)
        fi
        
        # Adicionar argumentos do usuário
        CMD+=("$@")
        
        echo -e "${CYAN}🚀 Criando projeto: ${GREEN}${PROJECT_NAME}${NC}"
        echo -e "${BLUE}Comando: ${CMD[*]}${NC}\n"
        
        cd "${TEMPLATE_DIR}"
        exec "${CMD[@]}"
        ;;
esac
