#!/usr/bin/env python3
"""
Template Composition CLI - IMP-65 Phase 4.3

Compose a template from modular blocks.

Usage:
    compose-template <template-path> <blocks-dir> [--output <path>] [--verbose]

Examples:
    # Compose template and print to stdout
    compose-template .specify/templates/spec-template.md .specify/templates/blocks

    # Compose and write to file
    compose-template .specify/templates/spec-template.md .specify/templates/blocks \
        --output composed-spec.md

    # Verbose mode (show composition details)
    compose-template .specify/templates/spec-template.md .specify/templates/blocks --verbose
"""

import argparse
import sys
from pathlib import Path

# Add scripts to path for imports
sys.path.insert(0, str(Path(__file__).parent.parent))

from lib.template_blocks import (
    compose_template,
    get_template_blocks,
    CompositionError,
    BlockNotFoundError,
    BlockValidationError,
)


def main():
    parser = argparse.ArgumentParser(
        description="Compose a template from modular blocks",
        epilog="Part of IMP-65 Phase 4 - Modular Template System"
    )

    parser.add_argument(
        "template",
        type=Path,
        help="Path to template file with @include directives"
    )

    parser.add_argument(
        "blocks_dir",
        type=Path,
        help="Directory containing block files"
    )

    parser.add_argument(
        "-o", "--output",
        type=Path,
        help="Output file path (default: stdout)"
    )

    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="Show composition details"
    )

    args = parser.parse_args()

    # Validate inputs
    if not args.template.exists():
        print(f"❌ Error: Template not found: {args.template}", file=sys.stderr)
        sys.exit(1)

    if not args.blocks_dir.exists():
        print(f"❌ Error: Blocks directory not found: {args.blocks_dir}", file=sys.stderr)
        sys.exit(1)

    try:
        # Show composition plan if verbose
        if args.verbose:
            print(f"📄 Template: {args.template}", file=sys.stderr)
            print(f"📦 Blocks directory: {args.blocks_dir}", file=sys.stderr)

            # Get list of blocks required
            try:
                blocks = get_template_blocks(args.template)
                if blocks:
                    print(f"🔗 Blocks to compose ({len(blocks)}):", file=sys.stderr)
                    for block in blocks:
                        print(f"   - {block}", file=sys.stderr)
                else:
                    print("ℹ️  No blocks to compose (monolithic template)", file=sys.stderr)
            except Exception as e:
                print(f"⚠️  Could not extract block list: {e}", file=sys.stderr)

            print(file=sys.stderr)

        # Compose template
        result = compose_template(args.template, args.blocks_dir, verbose=args.verbose)

        # Write output
        if args.output:
            args.output.parent.mkdir(parents=True, exist_ok=True)
            args.output.write_text(result, encoding='utf-8')

            if args.verbose:
                print(f"✅ Composed template written to: {args.output}", file=sys.stderr)
                print(f"   Size: {len(result)} chars, {result.count(chr(10))} lines", file=sys.stderr)
        else:
            # Print to stdout
            print(result)

        sys.exit(0)

    except BlockNotFoundError as e:
        print(f"❌ Error: {e}", file=sys.stderr)
        sys.exit(2)

    except BlockValidationError as e:
        print(f"❌ Validation error: {e}", file=sys.stderr)
        sys.exit(3)

    except CompositionError as e:
        print(f"❌ Composition error: {e}", file=sys.stderr)
        sys.exit(4)

    except Exception as e:
        print(f"❌ Unexpected error: {e}", file=sys.stderr)
        if args.verbose:
            import traceback
            traceback.print_exc()
        sys.exit(99)


if __name__ == '__main__':
    main()
