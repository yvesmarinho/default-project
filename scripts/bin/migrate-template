#!/usr/bin/env python3
"""
migrate-template - CLI tool to migrate monolithic templates to modular system.

Usage:
    migrate-template <template-path> [options]
    migrate-template --list
    migrate-template --batch <directory>

Options:
    --dry-run           Show what would happen without creating files
    --name <name>       Specify template name (default: filename)
    --guide <path>      Write migration guide to file
    --list              List all templates in project
    --batch <dir>       Migrate all templates in directory
    -v, --verbose       Show detailed output

Examples:
    # Migrate single template
    migrate-template templates/spec-template.md

    # Dry run to preview changes
    migrate-template templates/spec-template.md --dry-run

    # Migrate with custom name and guide output
    migrate-template spec.md --name my-spec --guide migration-guide.md

    # List all templates
    migrate-template --list

    # Batch migrate all templates in directory
    migrate-template --batch templates/

Part of IMP-65 Phase 4.4: Migration & Compatibility
"""

import sys
import argparse
from pathlib import Path

# Add scripts/lib to path
sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))

from template_migration import TemplateMigrator, list_templates, MigrationReport


def format_report(report: MigrationReport, verbose: bool = False) -> str:
    """Format migration report for display."""
    output = []
    output.append(f"📄 Template: {report.template_name}")
    output.append(f"   Custom sections: {report.custom_sections_found}")
    output.append(f"   Patches created: {len(report.patches_created)}")

    if report.backup_path:
        output.append(f"   Backup: {report.backup_path}")

    if verbose and report.patches_created:
        output.append("\n   Patches:")
        for patch in report.patches_created:
            output.append(f"      - {patch}")

    if report.warnings:
        output.append("\n   ⚠️  Warnings:")
        for warning in report.warnings:
            output.append(f"      - {warning}")

    return '\n'.join(output)


def migrate_single(
    template_path: Path,
    template_name: str = None,
    dry_run: bool = False,
    guide_path: Path = None,
    verbose: bool = False
) -> bool:
    """
    Migrate a single template.

    Returns:
        True if successful, False otherwise
    """
    try:
        project_root = Path.cwd()
        migrator = TemplateMigrator(project_root)

        print(f"🔄 Migrating: {template_path}")
        if dry_run:
            print("   (DRY RUN - no files will be created)")

        report = migrator.migrate_template(
            template_path,
            template_name=template_name,
            dry_run=dry_run
        )

        print(f"\n✅ Migration complete!")
        print(format_report(report, verbose=verbose))

        # Generate and save guide if requested
        if guide_path and not dry_run:
            guide = migrator.generate_migration_guide(report, output_path=guide_path)
            print(f"\n📝 Migration guide written to: {guide_path}")
        elif verbose and not dry_run:
            guide = migrator.generate_migration_guide(report)
            print(f"\n{guide}")

        return True

    except FileNotFoundError as e:
        print(f"❌ Error: {e}", file=sys.stderr)
        return False
    except Exception as e:
        print(f"❌ Migration failed: {e}", file=sys.stderr)
        if verbose:
            import traceback
            traceback.print_exc()
        return False


def list_project_templates(verbose: bool = False) -> bool:
    """
    List all templates in project.

    Returns:
        True if successful, False otherwise
    """
    try:
        project_root = Path.cwd()
        templates_dir = project_root / "templates"

        templates = list_templates(templates_dir)

        if not templates:
            print("No templates found in templates/")
            return True

        print(f"📋 Found {len(templates)} template(s) in templates/:\n")
        for template in templates:
            print(f"   - {template.name}")
            if verbose:
                size = template.stat().st_size
                print(f"     Size: {size:,} bytes")

        return True

    except Exception as e:
        print(f"❌ Error listing templates: {e}", file=sys.stderr)
        return False


def batch_migrate(
    directory: Path,
    dry_run: bool = False,
    verbose: bool = False
) -> bool:
    """
    Migrate all templates in a directory.

    Returns:
        True if all successful, False if any failed
    """
    try:
        templates = list_templates(directory)

        if not templates:
            print(f"No templates found in {directory}")
            return True

        print(f"🔄 Batch migrating {len(templates)} template(s)...\n")

        success_count = 0
        failed_count = 0

        for template in templates:
            result = migrate_single(
                template,
                template_name=template.stem,
                dry_run=dry_run,
                verbose=verbose
            )

            if result:
                success_count += 1
            else:
                failed_count += 1

            print()  # Blank line between templates

        print(f"📊 Batch migration complete:")
        print(f"   ✅ Success: {success_count}")
        if failed_count > 0:
            print(f"   ❌ Failed: {failed_count}")

        return failed_count == 0

    except Exception as e:
        print(f"❌ Batch migration failed: {e}", file=sys.stderr)
        return False


def main():
    """Main entry point."""
    parser = argparse.ArgumentParser(
        description="Migrate monolithic templates to modular block system",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__.split('Examples:')[1] if 'Examples:' in __doc__ else None
    )

    parser.add_argument(
        'template',
        nargs='?',
        type=Path,
        help="Path to template file to migrate"
    )

    parser.add_argument(
        '--dry-run',
        action='store_true',
        help="Show what would happen without creating files"
    )

    parser.add_argument(
        '--name',
        type=str,
        help="Specify template name (default: filename)"
    )

    parser.add_argument(
        '--guide',
        type=Path,
        help="Write migration guide to file"
    )

    parser.add_argument(
        '--list',
        action='store_true',
        help="List all templates in project"
    )

    parser.add_argument(
        '--batch',
        type=Path,
        metavar='DIR',
        help="Migrate all templates in directory"
    )

    parser.add_argument(
        '-v', '--verbose',
        action='store_true',
        help="Show detailed output"
    )

    args = parser.parse_args()

    # Handle list mode
    if args.list:
        success = list_project_templates(verbose=args.verbose)
        sys.exit(0 if success else 1)

    # Handle batch mode
    if args.batch:
        success = batch_migrate(
            args.batch,
            dry_run=args.dry_run,
            verbose=args.verbose
        )
        sys.exit(0 if success else 1)

    # Handle single template migration
    if not args.template:
        parser.print_help()
        sys.exit(1)

    success = migrate_single(
        args.template,
        template_name=args.name,
        dry_run=args.dry_run,
        guide_path=args.guide,
        verbose=args.verbose
    )

    sys.exit(0 if success else 1)


if __name__ == '__main__':
    main()
