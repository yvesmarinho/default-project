#!/usr/bin/env python3
"""
Patch Application CLI - IMP-65 Phase 4.3

Apply patches to a template.

Usage:
    apply-patches <template-content> <patches-dir> [--template-name <name>] [--output <path>] [--verbose]

Examples:
    # Apply patches from composed template
    apply-patches composed-spec.md .specify/templates/patches --template-name spec-template

    # Apply patches and write to file
    apply-patches composed-spec.md .specify/templates/patches \
        --template-name spec-template --output final-spec.md

    # Verbose mode (show patch application details)
    apply-patches composed-spec.md .specify/templates/patches \
        --template-name spec-template --verbose
"""

import argparse
import sys
from pathlib import Path

# Add scripts to path for imports
sys.path.insert(0, str(Path(__file__).parent.parent))

from lib.template_patches import (
    apply_patches,
    list_patches,
    PatchApplicationError,
    PatchConflictError,
)


def main():
    parser = argparse.ArgumentParser(
        description="Apply patches to a template",
        epilog="Part of IMP-65 Phase 4 - Modular Template System"
    )

    parser.add_argument(
        "template",
        type=Path,
        help="Path to template file (composed or monolithic)"
    )

    parser.add_argument(
        "patches_dir",
        type=Path,
        help="Directory containing patch files"
    )

    parser.add_argument(
        "-t", "--template-name",
        help="Template name (for multi-template patches directory)"
    )

    parser.add_argument(
        "-o", "--output",
        type=Path,
        help="Output file path (default: stdout)"
    )

    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="Show patch application details"
    )

    args = parser.parse_args()

    # Validate inputs
    if not args.template.exists():
        print(f"❌ Error: Template not found: {args.template}", file=sys.stderr)
        sys.exit(1)

    if not args.patches_dir.exists():
        print(f"⚠️  Warning: Patches directory not found: {args.patches_dir}", file=sys.stderr)
        print(f"ℹ️  No patches to apply - template unchanged", file=sys.stderr)
        # Just copy template to output
        content = args.template.read_text(encoding='utf-8')
        if args.output:
            args.output.write_text(content, encoding='utf-8')
        else:
            print(content)
        sys.exit(0)

    try:
        # Load template content
        content = args.template.read_text(encoding='utf-8')

        # Show patch plan if verbose
        if args.verbose:
            print(f"📄 Template: {args.template}", file=sys.stderr)
            print(f"📦 Patches directory: {args.patches_dir}", file=sys.stderr)
            if args.template_name:
                print(f"🏷️  Template name: {args.template_name}", file=sys.stderr)

            # List patches
            patches = list_patches(args.patches_dir, args.template_name)
            if patches:
                print(f"🔧 Patches to apply ({len(patches)}):", file=sys.stderr)
                for patch in patches:
                    print(f"   - {patch.source_file.name}: {patch.metadata.description}", file=sys.stderr)
                    print(f"     Operations: {len(patch.operations)}", file=sys.stderr)
            else:
                print("ℹ️  No patches found", file=sys.stderr)

            print(file=sys.stderr)

        # Apply patches
        result = apply_patches(content, args.patches_dir, args.template_name)

        # Calculate diff stats
        base_lines = content.count('\n')
        result_lines = result.count('\n')
        lines_added = result_lines - base_lines

        # Write output
        if args.output:
            args.output.parent.mkdir(parents=True, exist_ok=True)
            args.output.write_text(result, encoding='utf-8')

            if args.verbose:
                print(f"✅ Patched template written to: {args.output}", file=sys.stderr)
                print(f"   Size: {len(result)} chars, {result_lines} lines", file=sys.stderr)
                if lines_added != 0:
                    print(f"   Change: {lines_added:+d} lines", file=sys.stderr)
        else:
            # Print to stdout
            print(result)

        sys.exit(0)

    except PatchConflictError as e:
        print(f"❌ Patch conflict: {e}", file=sys.stderr)
        print(f"ℹ️  Hint: Make patch anchors more specific to avoid ambiguity", file=sys.stderr)
        sys.exit(2)

    except PatchApplicationError as e:
        print(f"❌ Application error: {e}", file=sys.stderr)
        sys.exit(3)

    except Exception as e:
        print(f"❌ Unexpected error: {e}", file=sys.stderr)
        if args.verbose:
            import traceback
            traceback.print_exc()
        sys.exit(99)


if __name__ == '__main__':
    main()
