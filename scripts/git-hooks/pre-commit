#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Pre-commit hook: segurança (IPs, credenciais, secrets) + validação de memória.

Modificado em: 14/07/2026 11:56

MODO MANUAL (padrão): o hook NÃO executa as validações automaticamente a cada
commit — evita consumo excessivo de tokens/saída quando há muitos commits/PRs.

Para executar as validações:
  - Manualmente (staged files):  python3 scripts/git-hooks/pre-commit --manual
  - Em um commit específico:     PRE_COMMIT_VALIDATE=1 git commit ...

Verificações:
  1. .secrets/ não commitado
  2. Nomes de arquivos sensíveis bloqueados
  3. IPs internos (RFC 1918) no conteúdo
  4. Credenciais hardcoded (Git Guardian rules)
  5. Arquivos de teste em .memory/ bloqueados
  6. YAML frontmatter de .memory/ validado

Instalação:
  cp scripts/git-hooks/pre-commit .git/hooks/pre-commit
  chmod +x .git/hooks/pre-commit
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

PROJECT_ROOT = Path(".git").exists() and Path.cwd() or Path(__file__).parent.parent.parent

# ---------------------------------------------------------------------------
# Constantes de configuração
# ---------------------------------------------------------------------------

SCAN_EXCLUDES = {
    ".git-hooks", "docs/bugs", "docs/debates", "docs/implementations",
    "tests", ".memory", "CHANGELOG.md", "SECURITY.md",
    "scaffold/templates", "scripts/lib",
}

TEXT_EXTENSIONS = {
    ".md", ".txt", ".yml", ".yaml", ".json", ".py", ".sh",
    ".conf", ".config", ".ini", ".toml", ".xml", ".html",
    ".js", ".ts", ".tf", ".hcl", ".j2", ".jinja",
    ".properties", ".cfg", ".sql", "", ".env.example",
}

# IPs internos (RFC 1918 + loopback + link-local)
IP_PATTERNS = [
    (re.compile(r"\b10\.\d{1,3}\.\d{1,3}\.\d{1,3}\b"),              "IP privado classe A (10.x.x.x)"),
    (re.compile(r"\b172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}\b"), "IP privado classe B (172.16-31.x.x)"),
    (re.compile(r"\b192\.168\.\d{1,3}\.\d{1,3}\b"),                 "IP privado classe C (192.168.x.x)"),
    (re.compile(r"\b127\.\d{1,3}\.\d{1,3}\.\d{1,3}\b"),             "IP loopback (127.x.x.x)"),
    (re.compile(r"\b169\.254\.\d{1,3}\.\d{1,3}\b"),                 "IP link-local (169.254.x.x)"),
]

# Credenciais hardcoded (Git Guardian rules)
CRED_PATTERNS = [
    (re.compile(r"-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----"),                                                               "Chave privada PEM"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"),                                                                                              "AWS Access Key ID"),
    (re.compile(r"(?i)aws.{0,20}(secret|key).{0,10}[=:]\s*['\"]?[A-Za-z0-9/+]{40}"),                                                 "AWS Secret Key"),
    (re.compile(r"\bghp_[A-Za-z0-9]{36}\b"),                                                                                          "GitHub Personal Token (ghp_)"),
    (re.compile(r"\bgho_[A-Za-z0-9]{36}\b"),                                                                                          "GitHub OAuth Token (gho_)"),
    (re.compile(r"\bghs_[A-Za-z0-9]{36}\b"),                                                                                          "GitHub App Token (ghs_)"),
    (re.compile(r"\bghr_[A-Za-z0-9]{36}\b"),                                                                                          "GitHub Refresh Token (ghr_)"),
    (re.compile(r"[a-zA-Z]+://[^/@\s]+:[^/@\s]+@[^/\s]"),                                                                             "Credencial em URL (user:pass@host)"),
    (re.compile(r"(?i)(password|passwd|secret|api_key|apikey|auth_token|access_token)\s*[=:]\s*['\"][^'\"\\s]{8,}['\"]"),             "Senha/token literal em variável"),
    (re.compile(r"(?i)Bearer\s+[A-Za-z0-9\-._~+/]{20,}={0,2}"),                                                                      "Bearer token hardcoded"),
    (re.compile(r"(?i)(password|secret)\s*:\s*[A-Za-z0-9+/]{16,}={0,2}\s*$", re.MULTILINE),                                          "Valor base64 suspeito em campo sensível"),
]

# Nomes de arquivo sensíveis
SENSITIVE_NAME_PATTERNS = [
    re.compile(r"\.env$"),
    re.compile(r"\.env\."),
    re.compile(r"\.key$"),
    re.compile(r"\.pem$"),
    re.compile(r"\.p12$"),
    re.compile(r"\.pfx$"),
    re.compile(r"\.crt$"),
    re.compile(r"\.cert$"),
    re.compile(r"\.vault_pass"),
    re.compile(r"kubeconfig"),
]

# Padrões de arquivo de teste em .memory/
MEMORY_TEST_PATTERNS = [
    re.compile(r"__test-.*\.md$"),
    re.compile(r"__auto-generated-title\.md$"),
    re.compile(r"__search-test-.*\.md$"),
]


# ---------------------------------------------------------------------------
# Utilitários
# ---------------------------------------------------------------------------

def get_staged_files() -> list[str]:
    r = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True,
    )
    return [f for f in r.stdout.strip().split("\n") if f]


def get_staged_content(filepath: str) -> str | None:
    try:
        r = subprocess.run(
            ["git", "show", f":{filepath}"],
            capture_output=True, text=True, errors="replace", timeout=10,
        )
        return r.stdout if r.returncode == 0 else None
    except Exception:
        return None


def should_exclude_from_content_scan(filepath: str) -> bool:
    p = Path(filepath)
    for excl in SCAN_EXCLUDES:
        if filepath.startswith(excl + "/") or filepath == excl:
            return True
    return p.suffix.lower() not in TEXT_EXTENSIONS


# ---------------------------------------------------------------------------
# Verificações
# ---------------------------------------------------------------------------

def check_secrets_dir(staged: list[str]) -> list[str]:
    blocked = [f for f in staged if f.startswith(".secrets/")]
    if blocked:
        msgs = ["❌ BLOQUEADO: .secrets/ não pode ser commitado:"]
        msgs += [f"  - {f}" for f in blocked]
        msgs += ["", "💡 git restore --staged .secrets/"]
        return msgs
    return []


def check_sensitive_filenames(staged: list[str]) -> list[str]:
    blocked = []
    for filepath in staged:
        if filepath.startswith(".git-hooks/"):
            continue
        name = Path(filepath).name
        for pat in SENSITIVE_NAME_PATTERNS:
            if pat.search(name):
                blocked.append(filepath)
                break
    if blocked:
        msgs = ["❌ BLOQUEADO: Nomes de arquivos sensíveis detectados:"]
        msgs += [f"  - {f}" for f in blocked]
        msgs += ["", "💡 Mova para .secrets/ ou adicione ao .gitignore"]
        return msgs
    return []


def check_ip_addresses(staged: list[str]) -> list[str]:
    violations: list[tuple[str, str, list[str]]] = []
    for filepath in staged:
        if should_exclude_from_content_scan(filepath):
            continue
        content = get_staged_content(filepath)
        if not content:
            continue
        for pattern, label in IP_PATTERNS:
            found = list(dict.fromkeys(pattern.findall(content)))
            if found:
                violations.append((filepath, label, found))
    if violations:
        msgs = ["❌ BLOQUEADO: IPs internos detectados no conteúdo:"]
        for filepath, label, ips in violations:
            masked = [ip[:3] + ".***.***" for ip in ips]
            msgs.append(f"  {filepath} → {label}: {masked}")
        msgs += ["", "💡 Substitua por placeholders: <IP_DO_HOST>, 0.0.0.0, ou variável de ambiente"]
        return msgs
    return []


def check_credentials(staged: list[str]) -> list[str]:
    violations: list[tuple[str, str]] = []
    for filepath in staged:
        if should_exclude_from_content_scan(filepath):
            continue
        content = get_staged_content(filepath)
        if not content:
            continue
        for pattern, label in CRED_PATTERNS:
            if pattern.search(content):
                violations.append((filepath, label))
    if violations:
        msgs = ["❌ BLOQUEADO: Credenciais hardcoded detectadas (Git Guardian rules):"]
        for filepath, label in violations:
            msgs.append(f"  {filepath} → {label}")
        msgs += ["", "💡 Mova para .secrets/*.json ou use variáveis de ambiente"]
        return msgs
    return []


def check_memory_test_files(staged: list[str]) -> list[str]:
    blocked = []
    for filepath in staged:
        if not filepath.startswith(".memory/"):
            continue
        for pat in MEMORY_TEST_PATTERNS:
            if pat.search(filepath):
                blocked.append(filepath)
                break
    if blocked:
        msgs = ["❌ BLOQUEADO: Arquivos de teste em .memory/ não devem ser commitados:"]
        msgs += [f"  - {f}" for f in blocked]
        return msgs
    return []


def check_memory_frontmatter(staged: list[str]) -> list[str]:
    errors = []
    valid_categories = {"project", "team", "sessions", "user"}
    for filepath in staged:
        if not (filepath.startswith(".memory/") and filepath.endswith(".md")):
            continue
        content = get_staged_content(filepath)
        if not content or not content.startswith("---"):
            continue
        parts = content.split("---", 2)
        if len(parts) < 3:
            errors.append(f"  {filepath}: frontmatter YAML sem fechamento '---'")
            continue
        frontmatter = parts[1].strip()
        if "category:" in frontmatter:
            m = re.search(r"category:\s*(\S+)", frontmatter)
            if m and m.group(1) not in valid_categories:
                errors.append(f"  {filepath}: categoria inválida '{m.group(1)}' (válidas: {valid_categories})")
    if errors:
        msgs = ["❌ BLOQUEADO: Frontmatter YAML inválido em .memory/:"]
        msgs += errors
        return msgs
    return []


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> int:
    manual = "--manual" in sys.argv
    if not manual and os.environ.get("PRE_COMMIT_VALIDATE") != "1":
        print(
            "⏭️  Pre-commit: validações desativadas no modo automático. "
            "Rodar manualmente: python3 scripts/git-hooks/pre-commit --manual "
            "(ou PRE_COMMIT_VALIDATE=1 git commit ...)"
        )
        return 0

    print("=" * 60)
    print("Pre-commit: Segurança + Validação de Memória")
    print("=" * 60)

    staged = get_staged_files()
    if not staged:
        print("✅ Nenhum arquivo staged")
        return 0

    all_errors: list[str] = []

    checks = [
        ("🔒 Verificando .secrets/",               check_secrets_dir),
        ("📁 Verificando nomes de arquivos",        check_sensitive_filenames),
        ("🌐 Verificando IPs internos no conteúdo", check_ip_addresses),
        ("🔑 Verificando credenciais hardcoded",    check_credentials),
        ("🧠 Verificando arquivos de teste em .memory/", check_memory_test_files),
        ("📋 Verificando frontmatter YAML",         check_memory_frontmatter),
    ]

    for label, fn in checks:
        print(f"\n{label}...")
        errors = fn(staged)
        if errors:
            all_errors.extend([""] + errors)
            print(f"  {errors[0]}")
        else:
            print("  ✅ OK")

    print("\n" + "=" * 60)
    if all_errors:
        print("❌ PRE-COMMIT FALHOU")
        print("=" * 60)
        for line in all_errors:
            print(line)
        print()
        return 1

    print("✅ TODAS AS VERIFICAÇÕES PASSARAM")
    print("=" * 60)
    return 0


if __name__ == "__main__":
    sys.exit(main())
