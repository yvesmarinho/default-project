# ============================================================
# Makefile.helm — Targets para gerenciar o Helm chart.
# Incluir no Makefile principal com: include Makefile.helm
# ============================================================

HELM        ?= helm
KUBECTL     ?= kubectl
CHART_DIR   ?= helm
RELEASE     ?= $(shell basename $(CURDIR))
NAMESPACE   ?= default

.PHONY: helm-lint helm-dry-run helm-install helm-upgrade helm-diff \
        helm-uninstall helm-status helm-rollback

## helm-lint: Valida o chart Helm (syntax + structure)
helm-lint:
	$(HELM) lint $(CHART_DIR)

## helm-dry-run: Renderiza os manifests sem aplicar ao cluster
helm-dry-run:
	$(HELM) upgrade --install $(RELEASE) $(CHART_DIR) \
		--namespace $(NAMESPACE) \
		--values $(CHART_DIR)/values.yaml \
		--values $(CHART_DIR)/values-staging.yaml \
		--dry-run \
		--debug

## helm-install: Instala o chart pela primeira vez
helm-install:
	$(HELM) install $(RELEASE) $(CHART_DIR) \
		--namespace $(NAMESPACE) \
		--create-namespace \
		--values $(CHART_DIR)/values.yaml \
		--values $(CHART_DIR)/values-staging.yaml \
		--wait

## helm-upgrade: Atualiza release existente (staging)
helm-upgrade:
	$(HELM) upgrade $(RELEASE) $(CHART_DIR) \
		--namespace $(NAMESPACE) \
		--values $(CHART_DIR)/values.yaml \
		--values $(CHART_DIR)/values-staging.yaml \
		--wait

## helm-upgrade-prod: Atualiza release em produção
helm-upgrade-prod:
	$(HELM) upgrade $(RELEASE) $(CHART_DIR) \
		--namespace $(NAMESPACE) \
		--values $(CHART_DIR)/values.yaml \
		--values $(CHART_DIR)/values-prod.yaml \
		--wait

## helm-diff: Mostra diferenças entre versão atual e próxima (requer plugin helm-diff)
helm-diff:
	$(HELM) diff upgrade $(RELEASE) $(CHART_DIR) \
		--namespace $(NAMESPACE) \
		--values $(CHART_DIR)/values.yaml \
		--values $(CHART_DIR)/values-staging.yaml

## helm-status: Mostra status do release
helm-status:
	$(HELM) status $(RELEASE) --namespace $(NAMESPACE)

## helm-rollback: Faz rollback para a versão anterior do release
helm-rollback:
	$(HELM) rollback $(RELEASE) --namespace $(NAMESPACE)

## helm-uninstall: Remove o release do cluster
helm-uninstall:
	$(HELM) uninstall $(RELEASE) --namespace $(NAMESPACE)
