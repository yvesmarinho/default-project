# ============================================================
# Makefile.terraform — Targets para gerenciar infra Terraform AWS.
# Incluir no Makefile principal com: include Makefile.terraform
# ============================================================

TF          ?= terraform
TF_DIR      ?= terraform
ENV         ?= staging
TF_VARS     ?= $(TF_DIR)/envs/$(ENV).tfvars
TF_PLAN_OUT ?= /tmp/$(ENV).tfplan

.PHONY: tf-init tf-fmt tf-validate tf-plan tf-apply tf-destroy \
        tf-show tf-output tf-refresh tf-security-scan

## tf-init: Inicializa o Terraform e baixa providers
tf-init:
	$(TF) -chdir=$(TF_DIR) init

## tf-fmt: Formata todos os arquivos .tf (in-place)
tf-fmt:
	$(TF) -chdir=$(TF_DIR) fmt -recursive

## tf-fmt-check: Verifica formatação sem modificar (para CI)
tf-fmt-check:
	$(TF) -chdir=$(TF_DIR) fmt -recursive -check -diff

## tf-validate: Valida a sintaxe sem acessar a AWS
tf-validate: tf-init
	$(TF) -chdir=$(TF_DIR) validate

## tf-plan: Exibe o plano de mudanças para ENV (default: staging)
tf-plan: tf-init tf-validate
	$(TF) -chdir=$(TF_DIR) plan \
		-var-file=envs/$(ENV).tfvars \
		-out=/tmp/$(ENV).tfplan
	@echo "✅ Plan salvo em /tmp/$(ENV).tfplan — revise antes de aplicar"

## tf-apply: Aplica o plano previamente gerado por tf-plan
tf-apply:
	@test -f $(TF_PLAN_OUT) || (echo "❌ Plan não encontrado. Execute 'make tf-plan ENV=$(ENV)' primeiro" && exit 1)
	$(TF) -chdir=$(TF_DIR) apply $(TF_PLAN_OUT)

## tf-show: Mostra o plano salvo em formato legível
tf-show:
	$(TF) -chdir=$(TF_DIR) show $(TF_PLAN_OUT)

## tf-output: Exibe os outputs do state atual
tf-output:
	$(TF) -chdir=$(TF_DIR) output

## tf-refresh: Sincroniza o state com o estado real na AWS
tf-refresh:
	$(TF) -chdir=$(TF_DIR) refresh \
		-var-file=envs/$(ENV).tfvars

## tf-security-scan: Verifica vulnerabilidades de segurança com checkov (requer: pip install checkov)
tf-security-scan:
	@command -v checkov > /dev/null || pip install checkov
	checkov -d $(TF_DIR) --framework terraform --output cli

## tf-destroy: DESTRÓI toda a infraestrutura (requer confirmação)
## ⚠️  Usar apenas em dev/staging — nunca em prod sem aprovação formal
tf-destroy:
	@read -p "⚠️  Destruir infraestrutura ENV=$(ENV)? Digite 'yes' para confirmar: " confirm; \
	[ "$$confirm" = "yes" ] || (echo "Cancelado" && exit 1)
	$(TF) -chdir=$(TF_DIR) destroy \
		-var-file=envs/$(ENV).tfvars
