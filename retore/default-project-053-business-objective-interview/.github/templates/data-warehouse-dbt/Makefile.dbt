# Makefile.dbt — Targets for dbt local development
# Include in project Makefile: include Makefile.dbt
# Or run directly: make -f Makefile.dbt <target>
# Requires: dbt-core + dbt-<adapter> installed (see requirements or pyproject.toml)

DBT_PROFILE ?= $(shell basename $(CURDIR))
DBT_TARGET  ?= dev

.PHONY: dbt-deps dbt-compile dbt-run dbt-test dbt-seed dbt-snapshot \
        dbt-docs dbt-docs-serve dbt-freshness dbt-clean dbt-debug

## Instala os pacotes declarados em packages.yml
dbt-deps:
	@dbt deps --profiles-dir dbt --project-dir dbt

## Compila os modelos (sem executar) — útil para validação de Jinja/SQL
dbt-compile:
	@dbt compile --profiles-dir dbt --project-dir dbt --target $(DBT_TARGET)

## Executa todos os modelos no ambiente alvo
dbt-run:
	@dbt run --profiles-dir dbt --project-dir dbt --target $(DBT_TARGET)

## Executa apenas os modelos de staging
dbt-run-staging:
	@dbt run --profiles-dir dbt --project-dir dbt --target $(DBT_TARGET) \
		--select staging

## Executa os testes de dados
dbt-test:
	@dbt test --profiles-dir dbt --project-dir dbt --target $(DBT_TARGET)

## Carrega seeds (arquivos CSV em dbt/seeds/)
dbt-seed:
	@dbt seed --profiles-dir dbt --project-dir dbt --target $(DBT_TARGET)

## Executa snapshots (SCDs)
dbt-snapshot:
	@dbt snapshot --profiles-dir dbt --project-dir dbt --target $(DBT_TARGET)

## Gera documentação HTML
dbt-docs:
	@dbt docs generate --profiles-dir dbt --project-dir dbt --target $(DBT_TARGET)

## Serve documentação no browser (http://localhost:8080)
dbt-docs-serve:
	@dbt docs serve --profiles-dir dbt --project-dir dbt --port 8080

## Verifica a atualidade das fontes (source freshness)
dbt-freshness:
	@dbt source freshness --profiles-dir dbt --project-dir dbt --target $(DBT_TARGET)

## Remove artefatos gerados (target/ e dbt_packages/)
dbt-clean:
	@dbt clean --profiles-dir dbt --project-dir dbt

## Valida a conexão com o banco de dados
dbt-debug:
	@dbt debug --profiles-dir dbt --project-dir dbt --target $(DBT_TARGET)
