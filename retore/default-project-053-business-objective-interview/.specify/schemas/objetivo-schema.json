{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vya.digital/schemas/speckit/objetivo.schema.json",
  "title": "SpecKit Business Objective Schema",
  "description": "JSON Schema for Layer 1 (Business) objective.yaml - defines business context, problem, value, and initial decisions before technical specification",
  "type": "object",
  "required": [
    "feature",
    "negocio",
    "produto",
    "metadata"
  ],
  "properties": {
    "feature": {
      "type": "object",
      "description": "Feature identification and tracking metadata",
      "required": [
        "id",
        "name",
        "created"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(IMP|BUG|FEAT|ENH)-[0-9]+$",
          "description": "Unique feature identifier (format: PREFIX-NUMBER, e.g., IMP-53, BUG-04)",
          "examples": [
            "IMP-53",
            "BUG-06",
            "FEAT-101"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100,
          "description": "Human-readable feature name (5-100 chars)",
          "examples": [
            "Session Search System",
            "objetivo.yaml + speckit.clarify"
          ]
        },
        "branch": {
          "type": "string",
          "pattern": "^[0-9]{3,4}-[a-z0-9-]+$",
          "description": "Git branch name (format: NNN-kebab-case, e.g., 053-objetivo-yaml)",
          "examples": [
            "053-objetivo-yaml",
            "051-session-search",
            "1001-user-authentication"
          ]
        },
        "created": {
          "type": "string",
          "format": "date",
          "description": "Feature creation date (ISO 8601 format: YYYY-MM-DD)",
          "examples": [
            "2026-04-14",
            "2026-04-05"
          ]
        }
      },
      "additionalProperties": false
    },
    "negocio": {
      "type": "object",
      "description": "Business context: problem, value proposition, and strategic objectives",
      "required": [
        "problema",
        "valor"
      ],
      "properties": {
        "problema": {
          "type": "object",
          "description": "Business problem definition and stakeholder impact",
          "required": [
            "descricao",
            "impacto_atual",
            "stakeholders"
          ],
          "properties": {
            "descricao": {
              "type": "string",
              "minLength": 20,
              "maxLength": 500,
              "description": "Clear description of the business problem (20-500 chars, focus on WHAT not HOW)",
              "examples": [
                "Developers cannot find context from previous sessions, leading to repeated questions and slower onboarding",
                "Users cannot search business objectives in existing features, causing duplicate work"
              ]
            },
            "impacto_atual": {
              "type": "string",
              "minLength": 20,
              "maxLength": 300,
              "description": "Current impact if problem is NOT solved (quantify when possible)",
              "examples": [
                "30% of development time wasted re-discovering context from past sessions",
                "Average 2h/week spent answering same questions from new team members"
              ]
            },
            "stakeholders": {
              "type": "array",
              "description": "List of affected stakeholders (users, teams, roles)",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 100
              },
              "examples": [
                [
                  "Developers",
                  "Product Managers",
                  "QA Engineers"
                ],
                [
                  "End users",
                  "Support team",
                  "DevOps engineers"
                ]
              ]
            }
          },
          "additionalProperties": false
        },
        "valor": {
          "type": "object",
          "description": "Value proposition: strategic objectives and success metrics",
          "required": [
            "objetivos_estrategicos",
            "metricas_sucesso"
          ],
          "properties": {
            "objetivos_estrategicos": {
              "type": "array",
              "description": "High-level strategic objectives (business goals, not technical tasks)",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 10,
                "maxLength": 200
              },
              "examples": [
                [
                  "Reduce onboarding time from weeks to days",
                  "Increase developer productivity by 20%"
                ],
                [
                  "Improve feature discoverability",
                  "Enable self-service documentation"
                ]
              ]
            },
            "metricas_sucesso": {
              "type": "array",
              "description": "Measurable success metrics (must be quantifiable)",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": [
                  "metric",
                  "target"
                ],
                "properties": {
                  "metric": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 100,
                    "description": "Metric name (what we're measuring)",
                    "examples": [
                      "Search query response time",
                      "Session docs indexed",
                      "Developer onboarding time"
                    ]
                  },
                  "target": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100,
                    "description": "Target value or threshold (specific, measurable)",
                    "examples": [
                      "<100ms average",
                      "100% of sessions indexed",
                      "Reduce from 2 weeks to 3 days"
                    ]
                  },
                  "baseline": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "Current baseline (optional, for comparison)",
                    "examples": [
                      "Currently 500ms",
                      "0% indexed",
                      "Currently 2 weeks"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "contexto": {
          "type": "object",
          "description": "Business context: constraints, assumptions, and bounded contexts (optional but recommended)",
          "properties": {
            "restricoes_negocio": {
              "type": "array",
              "description": "Business constraints (budget, timeline, compliance, regulatory)",
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 200
              },
              "examples": [
                [
                  "Must comply with LGPD",
                  "Budget limited to R$ 50k",
                  "Deadline: Q2 2026"
                ]
              ]
            },
            "premissas": {
              "type": "array",
              "description": "Business assumptions (things we assume to be true)",
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 200
              },
              "examples": [
                [
                  "Users have basic Git knowledge",
                  "Python 3.11+ available in environment"
                ]
              ]
            },
            "bounded_contexts": {
              "type": "array",
              "description": "Domain-Driven Design bounded contexts (if applicable)",
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 100
              },
              "examples": [
                [
                  "Session Management",
                  "Document Indexing",
                  "Search Query"
                ]
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "produto": {
      "type": "object",
      "description": "Product-level context: vision, personas, and critical user journeys",
      "required": [
        "visao_alto_nivel"
      ],
      "properties": {
        "visao_alto_nivel": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300,
          "description": "High-level product vision (20-300 chars, max 3 sentences, WHAT not HOW)",
          "examples": [
            "Enable developers to search session history via full-text search, finding context from past work in <100ms",
            "Allow users to create business objective artifacts before technical specs, ensuring alignment"
          ]
        },
        "personas": {
          "type": "array",
          "description": "Key user personas (who will use this feature)",
          "minItems": 0,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "name",
              "needs",
              "pain_points"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 3,
                "maxLength": 50,
                "description": "Persona name or role",
                "examples": [
                  "Senior Developer",
                  "Product Manager",
                  "New Team Member"
                ]
              },
              "needs": {
                "type": "string",
                "minLength": 10,
                "maxLength": 200,
                "description": "What this persona needs from the feature",
                "examples": [
                  "Find past architectural decisions quickly",
                  "Understand business context for features"
                ]
              },
              "pain_points": {
                "type": "string",
                "minLength": 10,
                "maxLength": 200,
                "description": "Current pain points this feature addresses",
                "examples": [
                  "Spends hours reading old session docs",
                  "Cannot find why decisions were made"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "jornadas_criticas": {
          "type": "array",
          "description": "Critical user journeys (prioritized: P1 = must-have MVP, P2 = important, P3 = nice-to-have)",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "journey",
              "priority",
              "value"
            ],
            "properties": {
              "journey": {
                "type": "string",
                "minLength": 10,
                "maxLength": 200,
                "description": "User journey description (action-oriented, verb-first)",
                "examples": [
                  "Search for 'SQLite FTS5' and find ADR-001 from IMP-51",
                  "Index all session docs on project initialization"
                ]
              },
              "priority": {
                "type": "string",
                "enum": [
                  "P1",
                  "P2",
                  "P3"
                ],
                "description": "Priority level (P1 = MVP must-have, P2 = important, P3 = nice-to-have)"
              },
              "value": {
                "type": "string",
                "minLength": 10,
                "maxLength": 200,
                "description": "Value delivered by this journey",
                "examples": [
                  "Enables instant context recovery",
                  "Reduces onboarding time by 50%"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "decisoes_iniciais": {
      "type": "array",
      "description": "Initial decisions made before technical specification (optional, bridges to ADRs)",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D-[0-9]{2,3}$",
            "description": "Decision ID (format: D-NN, e.g., D-01, D-02)",
            "examples": [
              "D-01",
              "D-02",
              "D-10"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200,
            "description": "Decision question (what was debated)",
            "examples": [
              "Build custom search or use external service?",
              "SQLite FTS5 vs embeddings for search?"
            ]
          },
          "decision": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300,
            "description": "Decision made (what was chosen and why, brief)",
            "examples": [
              "Build custom (SQLite FTS5) - zero dependencies, fast, simple",
              "Use Next.js App Router - modern, SSR support, community"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "perguntas_abertas": {
      "type": "array",
      "description": "Open questions that need answers before implementation (tracked for resolution)",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "question",
          "impact"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "description": "Open question (what we don't know yet)",
            "examples": [
              "What is acceptable search latency for 10k+ documents?",
              "Should we support fuzzy search or exact match only?"
            ]
          },
          "impact": {
            "type": "string",
            "enum": [
              "Alto",
              "Médio",
              "Baixo"
            ],
            "description": "Impact if question remains unanswered (Alto = blocks progress, Médio = affects design, Baixo = nice-to-know)"
          },
          "blocker": {
            "type": "boolean",
            "description": "Is this question a blocker for starting implementation? (optional, default: false)"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "description": "Feature metadata: ownership, team, and tagging",
      "required": [
        "owner",
        "team"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Product owner or feature owner (person responsible)",
          "examples": [
            "Yves Marinho",
            "Product Team"
          ]
        },
        "tech_lead": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Technical lead (optional, person responsible for architecture)",
          "examples": [
            "Yves Marinho",
            "Architecture Team"
          ]
        },
        "team": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Team responsible for implementation",
          "examples": [
            "DevEx",
            "Platform",
            "Product"
          ]
        },
        "tags": {
          "type": "array",
          "description": "Feature tags for categorization and search",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "pattern": "^[a-z0-9-]+$",
            "description": "Tag in kebab-case (lowercase, hyphens only)"
          },
          "examples": [
            [
              "search",
              "full-text",
              "sqlite",
              "fts5"
            ],
            [
              "business",
              "spec-driven-development",
              "yaml"
            ]
          ]
        },
        "template_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "objetivo-template.yaml version used (semver format)",
          "examples": [
            "1.0.0",
            "1.1.0"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$comment": "This schema validates Layer 1 (Business) objetivo.yaml files. Quality gates enforce >=1 metrica_sucesso, >=1 persona (recommended), and P1/P2/P3 journey prioritization."
}
