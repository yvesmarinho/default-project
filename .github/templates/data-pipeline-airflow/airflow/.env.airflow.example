# .env.airflow.example — Variáveis de ambiente para Airflow local
# NUNCA commitar este arquivo com valores reais
# Copie para .env.airflow e preencha com valores do seu ambiente

# Usuário admin da interface web
AIRFLOW_USERNAME=admin

# Fernet key — gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-change-me

# URL da fonte de dados (sobrescreve Airflow Variable 'source_url')
SOURCE_URL=http://your-data-source.example.com/api/v1/data

# Nota: senhas do Postgres e Airflow admin ficam em .secrets/
# (não em variáveis de ambiente, para evitar exposição em logs)
# .secrets/postgres_password.txt   → senha do Postgres
# .secrets/airflow_admin_password.txt → senha do usuário admin
