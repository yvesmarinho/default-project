# .env.airflow.example — Environment variables for local Airflow development
# Copy to .secrets/.env.airflow and fill in real values.
# NEVER commit the .secrets/ directory.

# ---- Airflow core ----
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__CORE__PLUGINS_FOLDER=/opt/airflow/plugins
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here

# ---- Metadata DB (PostgreSQL) ----
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# ---- Webserver ----
AIRFLOW__WEBSERVER__SECRET_KEY=your-webserver-secret-key-here
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=False

# ---- SMTP alerts (optional) ----
# AIRFLOW__SMTP__SMTP_HOST=smtp.example.com
# AIRFLOW__SMTP__SMTP_USER=alerts@example.com
# AIRFLOW__SMTP__SMTP_PASSWORD=your-smtp-password
# AIRFLOW__SMTP__SMTP_MAIL_FROM=airflow@example.com

# ---- Default admin user (first startup only) ----
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change-me-at-first-login
