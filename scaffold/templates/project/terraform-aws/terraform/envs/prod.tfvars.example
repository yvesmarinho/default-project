# ============================================================
# envs/prod.tfvars.example — Production environment values.
# Copy to prod.tfvars and fill in real values.
# NEVER commit prod.tfvars — it is gitignored.
# ============================================================

project_name   = "my-project"
env            = "prod"
aws_region     = "us-east-1"
aws_account_id = "123456789012"

# Network
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

# ECS
enable_ecs        = true
container_image   = "123456789012.dkr.ecr.us-east-1.amazonaws.com/my-project:1.0.0"
container_port    = 8000
ecs_cpu           = 512
ecs_memory        = 1024
ecs_desired_count = 2
health_check_path = "/api/health"

# RDS — enabled in production
enable_rds               = true
db_instance_class        = "db.t3.medium"
db_name                  = "appdb"
db_username              = "appuser"
db_allocated_storage     = 50
db_backup_retention_days = 14
db_deletion_protection   = true
