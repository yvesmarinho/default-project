# ============================================================
# envs/staging.tfvars.example — Staging environment values.
# Copy to staging.tfvars and fill in real values.
# NEVER commit staging.tfvars — it is gitignored.
# ============================================================

project_name  = "my-project"
env           = "staging"
aws_region    = "us-east-1"
aws_account_id = "123456789012"

# Network
vpc_cidr           = "10.1.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# ECS
enable_ecs        = true
container_image   = "123456789012.dkr.ecr.us-east-1.amazonaws.com/my-project:latest"
container_port    = 8000
ecs_cpu           = 256
ecs_memory        = 512
ecs_desired_count = 1
health_check_path = "/api/health"

# RDS — disabled by default for staging to reduce cost
# Enable when integration tests with real DB are required
enable_rds              = false
db_instance_class       = "db.t3.micro"
db_name                 = "appdb"
db_username             = "appuser"
db_allocated_storage    = 20
db_backup_retention_days = 3
db_deletion_protection  = false
